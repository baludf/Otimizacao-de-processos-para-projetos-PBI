	partition stgFuncionarios = m
		mode: import
		source =
				let
				 Fonte=Excel.Workbook(File.Contents(pCaminhoBaseRH),null,true),
				 Plan1=Fonte{[Item="Plan1",Kind="Sheet"]}[Data],
				 Cabecalhos=Table.PromoteHeaders(Plan1,[PromoteAllScalars=true]),
				 Tipos=Table.TransformColumnTypes(Cabecalhos,{{"ID RH",Int64.Type},{"Nome Completo",type text},{"Estado Civil",type text},{"Sexo",type text},{"Data de Nascimento",type datetime},{"Endereço",type text},{"Data de Contratacao",type datetime},{"Data de Demissao",type datetime},{"Salario Base",type number},{"Impostos",type number},{"Beneficios",type number},{"VT",type number},{"VR",type number},{"Cargo",type text},{"Nível",type text},{"Área",type text},{"Ferias Acumuladas",Int64.Type},{"Horas Extras",Int64.Type},{"Imagem",type text},{"Avaliação do Funcionário",type number},{"Trabalho em Equipe",Int64.Type},{"Liderança",Int64.Type},{"Comunicação",Int64.Type},{"Iniciativa",Int64.Type},{"Organização",Int64.Type}},"pt-BR"),
				 TextosLimpos=Table.TransformColumns(Tipos,{{"Nome Completo",each if _=null then null else Text.Trim(Text.Clean(_)),type text},{"Estado Civil",each if _=null then null else Text.Upper(Text.Trim(Text.Clean(_))),type text},{"Sexo",each if _=null then null else Text.Upper(Text.Trim(Text.Clean(_))),type text},{"Cargo",each if _=null then null else Text.Trim(Text.Clean(_)),type text},{"Nível",each if _=null then null else Text.Trim(Text.Clean(_)),type text},{"Área",each if _=null then null else Text.Trim(Text.Clean(_)),type text}}),
				 FlagData=Table.AddColumn(TextosLimpos,"Flag Data Demissão Antes Contratação",each [Data de Demissao]<>null and [Data de Demissao]<[Data de Contratacao],type logical),
				 FlagFinanceiro=Table.AddColumn(FlagData,"Flag Valor Financeiro Negativo",each List.AnyTrue(List.Transform({[Salario Base],[Impostos],[Beneficios],[VT],[VR]},each _<>null and _<0)),type logical),
				 FlagFerias=Table.AddColumn(FlagFinanceiro,"Flag Férias Negativas",each [Ferias Acumuladas]<>null and [Ferias Acumuladas]<0,type logical),
				 FlagHoras=Table.AddColumn(FlagFerias,"Flag Horas Extras Negativas",each [Horas Extras]<>null and [Horas Extras]<0,type logical),
				 FlagAvaliacao=Table.AddColumn(FlagHoras,"Flag Avaliação Fora 0 a 10",each [Avaliação do Funcionário]=null or [Avaliação do Funcionário]<0 or [Avaliação do Funcionário]>10,type logical),
				 FlagCompetencia=Table.AddColumn(FlagAvaliacao,"Flag Competência Fora 0 a 10",each List.AnyTrue(List.Transform({[Trabalho em Equipe],[Liderança],[Comunicação],[Iniciativa],[Organização]},each _=null or _<0 or _>10)),type logical),
				 FlagIdade=Table.AddColumn(FlagCompetencia,"Flag Idade Admissão Menor 18",each [Data de Nascimento]<>null and [Data de Contratacao]<>null and Duration.Days(Date.From([Data de Contratacao])-Date.From([Data de Nascimento]))/365.2425<18,type logical),
				 FlagRegistro=Table.AddColumn(FlagIdade,"Flag Registro Inválido",each [ID RH]=null or [Data de Contratacao]=null or [Flag Data Demissão Antes Contratação] or [Flag Valor Financeiro Negativo] or [Flag Férias Negativas] or [Flag Horas Extras Negativas] or [Flag Avaliação Fora 0 a 10] or [Flag Competência Fora 0 a 10],type logical)
				in FlagRegistro

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

