/// Calendário civil desconectado usado como eixo analítico para métricas por evento e por intervalo de vigência.
table dCalendario
	lineageTag: 6d59e329-030f-4393-a9d2-269f2950cf16
	dataCategory: Time

	/// Data do calendário civil.
	column Data
		isUnique
		formatString: dd/MM/yyyy
		lineageTag: 94f4e069-bd02-4ccb-a28c-36fe65009e66
		summarizeBy: none
		sourceColumn: [Date]

	column 'Ano Mês'
		lineageTag: 4fc1fb80-bd7b-4c4a-aba1-38ad0c742693
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano Mês]
		sortByColumn: 'Ano Mês Ordem'

	column 'Ano Mês Ordem'
		lineageTag: 4705fd90-0b6c-4098-b1ee-371c80249eb8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano Mês Ordem]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				VAR DataInicial = DATE(YEAR(MINX(ALL(fVinculosRH),fVinculosRH[Data Contratação])),1,1)
				VAR MaiorDataFonte = MAXX(ALL(fVinculosRH),COALESCE(fVinculosRH[Data Demissão],fVinculosRH[Data Contratação]))
				VAR DataFinal = DATE(YEAR(MAX(MaiorDataFonte,TODAY())),12,31)
				RETURN
				ADDCOLUMNS(
				 CALENDAR(DataInicial,DataFinal),
				 "Ano",YEAR([Date]),
				 "Trimestre Número",QUARTER([Date]),
				 "Trimestre","T"&FORMAT(QUARTER([Date]),"0"),
				 "Mês Número",MONTH([Date]),
				 "Mês",FORMAT([Date],"mmm","pt-BR"),
				 "Ano Mês",FORMAT([Date],"yyyy-MM"),
				 "Ano Mês Ordem",YEAR([Date])*100+MONTH([Date]),
				 "Dia",DAY([Date]),
				 "Dia da Semana Número",WEEKDAY([Date],2),
				 "Dia da Semana",FORMAT([Date],"ddd","pt-BR"),
				 "Início do Mês",DATE(YEAR([Date]),MONTH([Date]),1),
				 "Fim do Mês",EOMONTH([Date],0)
				)

