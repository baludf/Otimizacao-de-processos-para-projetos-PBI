	column 'Status do Vínculo'
		dataType: string
		lineageTag: 6face29f-e749-495f-9338-4a4ecfd01385
		summarizeBy: none
		sourceColumn: Status do Vínculo

	partition fVinculosRH = m
		mode: import
		source =
				let
				 Fonte=stgFuncionarios,
				 ComIdade=Table.AddColumn(Fonte,"Idade na Admissão",each if [Data de Nascimento]=null or [Data de Contratacao]=null then null else Number.RoundDown(Duration.Days(Date.From([Data de Contratacao])-Date.From([Data de Nascimento]))/365.2425),Int64.Type),
				 ComFaixa=Table.AddColumn(ComIdade,"Faixa Etária na Admissão",each if [Idade na Admissão]=null then "Não informado" else if [Idade na Admissão]<18 then "Menor de 18" else if [Idade na Admissão]<25 then "18 a 24" else if [Idade na Admissão]<35 then "25 a 34" else if [Idade na Admissão]<45 then "35 a 44" else if [Idade na Admissão]<55 then "45 a 54" else "55 ou mais",type text),
				 ComStatus=Table.AddColumn(ComFaixa,"Status do Vínculo",each if [Data de Demissao]=null then "Sem data de desligamento" else "Desligado",type text),
				 SemPII=Table.RemoveColumns(ComStatus,{"Nome Completo","Data de Nascimento","Endereço","Imagem"}),
				 Renomeadas=Table.RenameColumns(SemPII,{{"Data de Contratacao","Data Contratação"},{"Data de Demissao","Data Demissão"},{"Salario Base","Salário Base"},{"Beneficios","Benefícios"},{"Ferias Acumuladas","Férias Acumuladas"}})
				in Renomeadas

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

