/// Fato de vínculos de RH, uma linha por ID RH. Exclui nome, nascimento, endereço e imagem da camada analítica.
table fVinculosRH
	lineageTag: aa860cea-5619-493b-ad79-bae5d1ebc114

	/// Chave única do vínculo na fonte.
	column 'ID RH'
		dataType: int64
		isHidden
		isUnique
		lineageTag: 3982d268-3e8b-4819-b3f8-6ab30f6970ae
		summarizeBy: sum
		sourceColumn: ID RH

		annotation SummarizationSetBy = Automatic

	column 'Estado Civil'
