table '_Aud_CatalogoStatus'
	lineageTag: 3747a3bf-0857-4111-83f8-1601ac76dfd5

	column Tipo
		lineageTag: 6ed32264-cef4-43b1-9a6a-9efc600b2ee3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tipo]

